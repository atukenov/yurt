{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "yurt-api",
    "Audience": "yurt-clients",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "7"
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:4300",
    "capacitor://localhost",
    "https://localhost",
    "https://altyncup.vercel.app",
    "https://altyncup-i71j.vercel.app",
    "https://www.altyncup.kz"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/yurt-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "localhost",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "POST:/api/v1/auth/login", "Period": "1m", "Limit": 10 },
      {
        "Endpoint": "POST:/api/v1/auth/register/start",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/v1/auth/register/verify",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/v1/auth/me/phone/start",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/v1/auth/me/phone/verify",
        "Period": "1m",
        "Limit": 10
      },
      { "Endpoint": "POST:/api/v1/auth/refresh", "Period": "1m", "Limit": 20 },
      { "Endpoint": "POST:/api/v1/auth/logout", "Period": "1m", "Limit": 20 },
      { "Endpoint": "POST:/api/v1/orders", "Period": "1m", "Limit": 10 },
      {
        "Endpoint": "POST:/api/v1/group-orders/join",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/v1/admin/auth/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/v1/admin/auth/refresh",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/v1/admin/auth/logout",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/v1/payments/create",
        "Period": "1m",
        "Limit": 10
      },
      { "Endpoint": "GET:/api/v1/loyalty/me", "Period": "1m", "Limit": 30 }
    ]
  },
  "Otp": {
    "Required": true,
    "Enabled": false,
    "GreenApiBaseUrl": "https://api.green-api.com",
    "IdInstance": "",
    "ApiTokenInstance": "",
    "CodeExpiryMinutes": 15,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "MessageTemplate": "Your Yurt verification code: {code}"
  },
  "Iiko": {
    "Enabled": false,
    "BaseUrl": "https://api-ru.iiko.services",
    "ApiKey": "",
    "AppId": "",
    "ClientSecret": "",
    "OrganizationId": "00000000-0000-0000-0000-000000000000",
    "ProgramId": "00000000-0000-0000-0000-000000000000",
    "EarnPercent": 10,
    "PushOrdersEnabled": false,
    "PaymentTypeId": "00000000-0000-0000-0000-000000000000",
    "WebhookAuthToken": ""
  },
  "AppUpdate": {
    "MinVersionIos": "",
    "MinVersionAndroid": "",
    "StoreUrlIos": "",
    "StoreUrlAndroid": ""
  },
  "// Firebase:ServiceAccountJson": "Set via `dotnet user-secrets set Firebase:ServiceAccountJson \"...\"` or the Firebase__ServiceAccountJson env var — never commit the real value. See docs/push-notifications-setup.md.",
  "Firebase": {
    "Enabled": true,
    "ProjectId": "altyncup-kz",
    "ServiceAccountJson": ""
  },
  "FreedomPay": {
    "Enabled": false,
    "AppleMerchantId": "merchant.com.altyncup.app"
  },
  "Payment": {
    "WebhookCallbackUrl": "http://localhost:5000/api/payments/webhook",
    "WebhookSecret": "CHANGE_THIS_TO_A_LONG_SECRET",
    "SandboxSecret": "CHANGE_THIS_TO_A_DIFFERENT_SECRET",
    "SandboxBaseUrl": "https://kaspi.sandbox.example",
    "ProcessingDelaySecondsMin": 2,
    "ProcessingDelaySecondsMax": 10,
    "DuplicateWebhookChance": 0.05,
    "NetworkFailureChance": 0.05
  }
}
